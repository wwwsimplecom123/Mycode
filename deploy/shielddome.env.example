SHIELDDOME_DATABASE_URL=postgresql://shielddome:CHANGE_ME@127.0.0.1:5432/shielddome
SHIELDDOME_RAW_STORAGE_DIR=/var/lib/shielddome/raw
SHIELDDOME_DATA_ENCRYPTION_KEY=GENERATE_WITH_PYTHON_SECRETS_TOKEN_URLSAFE_32
SHIELDDOME_ADMIN_TOKEN=CHANGE_TO_A_LONG_RANDOM_TOKEN
SHIELDDOME_INGEST_TOKEN=CHANGE_TO_A_DIFFERENT_LONG_RANDOM_TOKEN
SHIELDDOME_BOOTSTRAP_ADMIN_USERNAME=admin
SHIELDDOME_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD_OF_AT_LEAST_12_CHARACTERS
SHIELDDOME_LLM_API_KEY=REVOKE_THE_EXPOSED_KEY_AND_PUT_A_NEW_KEY_HERE
SHIELDDOME_LLM_ENDPOINT=https://api.siliconflow.cn/v1/chat/completions
SHIELDDOME_LLM_MODEL=Pro/zai-org/GLM-4.7
SHIELDDOME_EMBEDDING_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
SHIELDDOME_EMBEDDING_MODEL=BAAI/bge-m3
SHIELDDOME_PROVIDER_TIMEOUT_SECONDS=25
SHIELDDOME_MAX_UPLOAD_BYTES=52428800
SHIELDDOME_RAW_RETENTION_HOURS=72
SHIELDDOME_RECORD_RETENTION_DAYS=180
SHIELDDOME_WORKER_MAX_ATTEMPTS=3
